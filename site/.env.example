# Copy to .env.local for development; set the same variables in the hosting
# dashboard for production. Never commit real values.

# Production origin, no trailing slash. Used for canonical URLs, OG, sitemap,
# Stripe redirect URLs and emailed access links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Paid video: /video stays in "not set up" mode until ALL of these are set ----

# Stripe (Dashboard > Developers > API keys). Use sk_test_ keys for testing.
STRIPE_SECRET_KEY=
# Webhook signing secret. Production: Dashboard > Webhooks > endpoint
# https://<domain>/api/stripe/webhook, event checkout.session.completed.
# Local: printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=
# One-time Price for the video (price_...). The site shows this price.
STRIPE_VIDEO_PRICE_ID=

# Random secret that signs access cookies and emailed links. Changing it logs
# everyone out; buyers can get a new link with "Email my link".
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ACCESS_TOKEN_SECRET=

# Cloudflare Stream. The video must have requireSignedURLs set to true.
# Customer code: the "customer-XXXX" part of the video's embed URL.
CLOUDFLARE_STREAM_CUSTOMER_CODE=
CLOUDFLARE_STREAM_VIDEO_UID=
# Signing key from POST /accounts/{account_id}/stream/keys: use its "id" and
# its "pem" value (already base64-encoded).
CLOUDFLARE_STREAM_KEY_ID=
CLOUDFLARE_STREAM_KEY_PEM=

# Resend (resend.com) for emailing access links. The sending domain must be
# verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Spray Tan By Jenna <video@example.com>"
